{
    "name": "esanj/remote-eloquent",
    "description": "Remote Eloquent models for Laravel — run native Eloquent queries against the Esanj Accounting service over gRPC or REST.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Esanj Tech Team",
            "email": "tech@esanj.ir"
        }
    ],
    "require": {
        "php": "^8.2|^8.3|^8.4",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.0|^11.0|^12.0"
    },
    "suggest": {
        "ext-grpc": "Required for the gRPC transport (REMOTE_ELOQUENT_DRIVER=grpc).",
        "grpc/grpc": "Provides the \\Grpc\\BaseStub client used by the gRPC transport.",
        "google/protobuf": "Required to (de)serialize the gRPC QueryRequest/QueryResponse messages.",
        "esanj/auth-bridge": "Reuse an existing client-credentials token issuer instead of the built-in AccessTokenManager."
    },
    "autoload": {
        "psr-4": {
            "Esanj\\RemoteEloquent\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Esanj\\RemoteEloquent\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Esanj\\RemoteEloquent\\RemoteEloquentServiceProvider"
            ],
            "aliases": {
                "RemoteQuery": "Esanj\\RemoteEloquent\\Facades\\RemoteQuery"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}